//warna tank
const hborder = .01;
const warna_celah_armor = vec3f(.2);
const warna_baut = vec3f(.5);
const warna_kotak_kecil = vec3f(.34);
const warna_fill = vec3f(.3);
const offset_baut = .04;

fn sampingroda(
	o:tank_out,
)-> vec4f{
	let dis = distance(
		o.posv,
		o.posvface,
	);
	let garis = .4 < dis && dis < 1.3;
	return select(
		vec4f(warna_celah_armor,1.,),
		vec4f(warna_kotak_kecil,1.,),
		garis,
	);
}

fn tepiroda(
	o:tank_out,
)-> vec4f{
	let garis = flomod(o.posv.x,.18,) < .13;
	return select(
		vec4f(warna_kotak_kecil,1.,),
		vec4f(warna_celah_armor,1.,),
		garis,
	);
}

fn hopscotch(
	x0:f32,
	z0:f32,
) -> vec4f{
	
	let z = flomod(floor(z0),5.,);
	let x = flomod(z*2.+x0,5.,);
	let u = flomod(x0,1.,);
	let v = flomod(z0,1.,);
	
	var warna0 = hkk(u,v,);
	warna0 = select(warna0,hkb(u,v,),1. < x,);
	warna0 = select(warna0,hkb(1.-u,v,),2. < x,);
	warna0 = select(warna0,hkb(u,1.-v,),3. < x,);
	warna0 = select(warna0,hkb(1.-u,1.-v,),4. < x,);
	
	return warna0;
}



//hopscotch kotak kecil -+-+-+-+-+-+-+-+-+-+-+-
fn hkk(
	u:f32,
	v:f32,
) ->vec4f{
	let wca = warna_celah_armor;
	let wkk = warna_kotak_kecil;
	let hb = hborder;
	return select(
		vec4f(wca,1.,),
		vec4f(wkk,1.,),
		hb < u
		&& u < 1.-hb
		&& hb < v
		&& v < 1.-hb
		,
	);
}

//hopscotch kotak besar -+-+-+-+-+-+-+-+-+-+-+-
fn hkb(
	u0:f32,
	v0:f32,
) ->vec4f{
	let wca = warna_celah_armor;
	let wb = warna_baut;
	let wf = warna_fill;
	let u = select(u0,v0,u0 > v0,);
	let v = select(v0,u0,u0 > v0,);
	
	let ob = offset_baut;
	var warna = vec4f(wca,1.,); //border
	warna = select(warna,vec4f(wf,1.,),hborder < u,); //sampe sini, //fill //vec4f(u,.0,v,1.,)
	warna = select(warna,vec4f(wb,1.,),
		distance(
			vec2f(u,v,),
			vec2f(.05,floor((v+ob)/ob/2.)*ob*2.,),
		) < .01
	,); //baut
	
	return warna;
}

@vertex fn splash0_vert(
	
	@location(0) posv:vec3f,
	
	@builtin(vertex_index) vi:u32,
	@builtin(instance_index) ii:u32,
)-> splash0_out {
	
	var p1 = vec4f(posv,1.,);
	p1.y = acakbit3(f32(vi));
	
	return splash0_out(
		uni.cam*p1,
	);
}

struct splash0_out{
	@builtin(position) posout:vec4f,
}

@fragment fn splash0_frag(
	o:splash0_out,
)-> @location(0) vec4f {
	return vec4f(1.15,.1,1.05,1.,);
}

