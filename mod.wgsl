@vertex fn stick_vert(
	
	@location(0) posv:vec3f,
	
	@builtin(vertex_index) vi:u32,
	@builtin(instance_index) ii:u32,
)-> stick_out {
	let fvi = f32(vi);
	let fii = f32(ii);
	
	var mout = putarY(select(
		1.,
		-1.,
		bool(ii%2),
	));
	
	let info = uni.wave;
	let boff =
		info.offset
		+info.stride *0u
	;
	let d = 2.; //distance antar stick
	let b01d = 100.; //distance antar bones
	let b01off = f32(ii)/b01d*d;
	let wei = cublerp(b01off%1.);
	let b0 = u32(floor(wei))+u32(b01off);
	let b1 = u32(ceil(wei))+u32(b01off);
	
	var wavearm =
		bones[b0+boff]*(1.-wei)+
		bones[b1+boff]*wei
	;

	mout = uni.cam*wavearm*cobra_wave(ii,d,)*mout;
	var pout = mout*vec4f(posv,1.,);
	
	return stick_out(
		getar0(pout,fvi,fii,),
		ii,
	);
}

struct stick_out{
	@builtin(position) posout:vec4f,
	@location(0) @interpolate(flat) ii:u32,
}

@fragment fn stick_frag(
	o:stick_out,
)-> @location(0) vec4f {
	
	let ii1 = i32(o.ii*111u)%3333i;
	let t = (uni.t*5i+i32(o.ii))%3333i;
	
	return select(
		vec4f(.7),
		vec4f(1.),
		ii1 < t &&
		t < ii1+222i,
	);
}

fn cobra_wave(
	ii:u32,
	d:f32, //distance antar stick
)->mat4x4f{
/*========
//ASLI smooth
	var t2 = f32(uni.env_t)*.001 -3.; //mulai
	var t1 = t2 -f32(uni.env_dt)*acakbit3(t2)*.001; //lag fx
--------*/
//BARU keyframed
	let boff = uni.stick.offset;
	var t2 = bones[boff][3].x; //mulai
	var t1 = t2;
//
	
	let speed = 111.;
	t2 *= speed;
	t1 *= speed;
	let fii = f32(ii);
	let t_inst2 = t2-d*fii;
	let t_inst1 = t1-d*fii;
	var mout = matide;
	var m0 = matide;
	var m1 = matide;



//geser
	m0 = matide;
	m0[3][0] = -t_inst1;
	
	m0 = array(mout,m0,)[u32(t_inst1 < .0)];
mout = m0;


//putar
	let r = 19.  ; //radius
	m0 = matide;
	m1 = matide;
	m0[3][1] = r;
	m1[3][1] = -r;
	var rot = -t_inst1/r;
	rot = max(rot,-1.3,);
	m0 = m0*putarZ(rot)*m1;
	
	m1 = array(mout,m0,)[u32(.0 < t_inst1 )];
mout = m1;


//lempar
	m0 = matide;
	let l_s = 24.; //lempar start
	var t_le = t_inst1-l_s; //t lempar
	t_le = -max(t_le*.4,.0,)*(3.+11.*acakbit3(fii));
	m0[3][1] = t_le;
	m0 = mout
	*m0
	*putarZ(t_le*-.6)
	*putarX(t_le*.2*acakbit3(fii+99.));
mout = m0;


//maju
	mout[3][0] += t1;
	
	
	
	return mout;
}

@vertex fn bunga_vert(
	
	@location(0) posv:vec3f,
	
	@builtin(vertex_index) vi:u32,
	@builtin(instance_index) ii:u32,
)-> bunga_out {
	let fvi = f32(vi);
	let fii = f32(ii);
	
	let info = uni.pecut;
	let boff =
		info.offset
		+info.stride *0u
	;
	let d = 1.; //distance antar bunga
	let b01d = 12.; //distance antar bones
	let b01off = f32(ii)/b01d*d;
	let wei = cublerp(b01off%1.);
	let b0 = u32(floor(wei))+u32(b01off);
	let b1 = u32(ceil(wei))+u32(b01off);
	
	var pecutarm =
		bones[b0+boff]*(1.-wei)+
		bones[b1+boff]*wei
	;
	
	let pos1 = posv+vec3f(.0,fii,.0,);
	var pout = uni.cam*pecutarm*vec4f(pos1,1.,);
	
	return bunga_out(
		getar0(pout,fvi,fii,),
	);
}

struct bunga_out{
	@builtin(position) posout:vec4f,
}

@fragment fn bunga_frag(
	o:bunga_out,
)-> @location(0) vec4f {
	
	return vec4f(1.,.5,1.,.8,);
}

@vertex fn tanah_vert(
	
	@location(0) posv:vec3f,
	
	@builtin(vertex_index) vi:u32,
	@builtin(instance_index) ii:u32,
)-> tanah_out {
	
	let p1 = vec4f(posv,1.,);
	
	return tanah_out(
		uni.cam*p1,
		p1,
	);
}

struct tanah_out{
	@builtin(position) posout:vec4f,
	@location(0) p:vec4f,
}

@fragment fn tanah_frag(
	o:tanah_out,
)-> @location(0) vec4f {
	
	let x = o.p.x;
	let y = o.p.y;
	let z = o.p.z;
	

//ASLI
	let wa = select(
		select(
			vec4f(1.,.8,.4,1.9,),
			vec4f(.8,.7,.3,1.9,),
			corak0(o.p.xyz),
		),
		select(
			vec4f(.85,.75,.4,1.9,),
			vec4f(.75,.65,.3,1.9,),
			flomod(sin(x),cos(x),) < sin(z),
		),
		tan(x+pow(.7,z,)) < sin(z+pow(1.,x,)+.2*x),
	);
	
	return wa*vec4f(vec3f(.3),1.,); //vec4f(.15,.1,.05,1.,);





//COBA
	return hopscotch(x,z,);
}

@vertex fn tank_vert(
	
	@location(0) jw:i32,
	@location(1) posv:vec3f,
	@location(2) extra:i32, //nor warna_i pad pad
	
	@builtin(vertex_index) vi:u32,
	@builtin(instance_index) ii:u32,
)-> tank_out {
	let extra1 = unpack4xU8(bitcast<u32>(extra));
	let m0 =  boneinfl(
		jw,
		uni.tank,
		ii,
	);
	let norinit = norarr[extra1[0]]; //initial
	let nor = fnor(m0,vec4f(
		norinit,
		.0,
	),).xyz;
	
	let p1 = m0*vec4f(posv,1.,);
	return tank_out(
		uni.cam*p1,
		norinit.y,
		nor.xyz,
		nor.xyz,
		extra1[1],
		posv,
		posv,
	);
}

struct tank_out{
	@builtin(position) posout:vec4f,
	@location(0) norinity:f32,
	@location(1) nor:vec3f,
	@location(2) @interpolate(flat) norface:vec3f,
	@location(3) @interpolate(flat) warna_i:u32,
	@location(4) posv:vec3f,
	@location(5) @interpolate(flat) posvface:vec3f,
}

@fragment fn tank_frag(
	o:tank_out,
)-> @location(0) vec4f {
	
	let niy = .0; //o.norinity; //floor(o.norinity/.27)*.27;
	let x = ( o.posv.x*.27+1.1 )+niy;
	let y = o.posv.y*.27;
	let z = ( o.posv.z*.27+.33 )+niy;
	
	let wi = o.warna_i;
	var colout = vec4f(.5);
	colout = select(colout,hopscotch(x,z,),wi == 0u);
	colout = select(colout,hopscotch(x*1.8,z*1.8,),wi == 1u);
	colout = select(colout,hopscotch(x*9.,z*9.,) *vec4f(vec3f(.8),1.,),wi == 2u);
	colout = select(colout,hopscotch(x*2.,z*13.,) *vec4f(vec3f(.6),1.,),wi == 3u);
	colout = select(colout,sampingroda(o),wi == 4u,);
	colout = select(colout,tepiroda(o),wi == 5u,);
	
	return vec4f(fsinar(
		colout.xyz,
		vec4f(o.nor,1.,),
	).xyz,colout.a,);
	return colout;
	
/*========
	return vec4f(select(
